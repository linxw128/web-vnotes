---
// A lightweight, framework-free search component that does substring matching
// Props: poststosearch (array of Astro content entries)
const { poststosearch } = Astro.props;
const index = poststosearch.map((p) => ({
  title: p.data?.title ?? "",
  description: p.data?.description ?? "",
  slug: p.slug,
}));
// JSON-encode safely (escape closing script tags)
const indexJSON = JSON.stringify(index).replace(/</g, "\\u003c");
---

<div class="search-root">
  <div class="flex items-center border border-zinc-800 px-3 py-2 gap-2 shadow-sm sm:text-sm">
    <span className="pointer-events-none text-gray-500">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
        <path fill="currentColor" d="m19.6 21l-6.3-6.3q-.75.6-1.725.95T9.5 16q-2.725 0-4.612-1.888T3 9.5q0-2.725 1.888-4.612T9.5 3q2.725 0 4.613 1.888T16 9.5q0 1.1-.35 2.075T14.7 13.3l6.3 6.3zM9.5 14q1.875 0 3.188-1.312T14 9.5q0-1.875-1.312-3.187T9.5 5Q7.625 5 6.313 6.313T5 9.5q0 1.875 1.313 3.188T9.5 14" />
      </svg>
    </span>

    <label for="SearchBox" class="sr-only background-blue-50">Search Posts</label>

    <input
      type="text"
      id="SearchBox"
      autocomplete="off"
      placeholder="Search for Posts"
      class="w-full outline-none bg-transparent focus:bg-transparent target:bg-transparent"
    />
  </div>

  <div id="SearchResults" class="pt-8 background-blue-50"></div>
</div>

<script type="application/json" id="__SEARCH_INDEX_DATA" set:html={indexJSON}></script>
<script>
  // Hydration-free client search: load pre-serialized index and perform simple substring matching.
  (function () {
    const raw = document.getElementById('__SEARCH_INDEX_DATA')?.textContent || '[]';
    let posts = [];
    try {
      posts = JSON.parse(raw);
      console.debug('[Search] index length:', posts.length);
    } catch (err) {
      console.error('[Search] failed to parse index JSON', err, raw.slice(0, 200));
    }

    const root = document.querySelector('.search-root');
    if (!root) return;
    const input = root.querySelector('#SearchBox');
    const results = root.querySelector('#SearchResults');

    function renderResults(items) {
      if (!items || items.length === 0) {
        results.innerHTML = '<div class="text-sm text-gray-400">No results</div>';
        return;
      }
      const html = items.map(item => {
        const title = item.title || '';
        return `<a href="/blog/${item.slug}"><div class="text-green-500 text-xl p-2 border-b border-zinc-800 hover:bg-zinc-800 hover:text-white transition-all ease-in-out duration-300 cursor-pointer">${escapeHtml(title)}</div></a>`;
      }).join('');
      results.innerHTML = html;
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function(m){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]; });
    }

    if (!input) {
      console.warn('[Search] input element not found');
      return;
    }

    input.addEventListener('input', function (e) {
      const q = (e.target.value || '').trim().toLowerCase();
      console.debug('[Search] query:', q);
      if (!q) {
        renderResults([]);
        return;
      }
      const filtered = posts.filter(p => {
        return (p.title && p.title.toLowerCase().includes(q)) || (p.description && p.description.toLowerCase().includes(q));
      }).slice(0, 20);
      console.debug('[Search] results:', filtered.length);
      renderResults(filtered);
    });
  })();
</script>
