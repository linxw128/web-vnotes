---
export interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  title?: string;
}

const { headings = [], title } = Astro.props;
---

{headings.length > 0 && (
  <>
    <!-- Mobile: collapsible at top -->
    <details class="lg:hidden mb-4 not-prose rounded border border-zinc-800 bg-zinc-900/50 p-3">
      <summary class="font-semibold cursor-pointer">目录</summary>
      <ul class="mt-3 space-y-2 text-sm max-h-[40vh] overflow-auto">
        {headings.map((heading) => (
          <li style={`margin-left: ${(heading.depth - 1) * 1}rem;`}>
            <a href={`#${heading.slug}`} class="hover:text-blue-400">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <!-- Desktop: sticky left column (initially static, sticks when scrolled) -->
    <nav aria-label="Table of contents" id="toc-main" class="toc not-prose hidden lg:block w-48 lg:sticky lg:top-24 self-start z-20 bg-zinc-900/80 p-3 rounded shadow-lg">
      <h3 class="font-semibold mb-4">{title ?? '本页内容'}</h3>
      <ul class="space-y-2 text-sm max-h-[calc(100vh-6rem)] overflow-auto">
        {headings.map((heading) => (
          <li style={`margin-left: ${(heading.depth - 1) * 1}rem;`}>
            <a href={`#${heading.slug}`} class="hover:text-blue-400">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <script>
      (function(){
        if (typeof window === 'undefined') return;
        // TOP corresponds to tailwind's top-24 (6rem = 96px)
        const TOP = 96; // px
        const LG_MIN = 1024; // tailwind lg breakpoint
        const nav = document.getElementById('toc-main');
        if (!nav) return;
        let placeholder = null;
        let fixed = false;
        let originalOffset = null;

        function calcOriginalOffset() {
          // ensure no placeholder interferes when measuring
          if (placeholder && placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
          const rect = nav.getBoundingClientRect();
          originalOffset = rect.top + window.scrollY;
        }

        function toFixed() {
          if (fixed) return;
          const rect = nav.getBoundingClientRect();
          placeholder = document.createElement('div');
          placeholder.style.width = rect.width + 'px';
          placeholder.style.height = rect.height + 'px';
          nav.parentNode.insertBefore(placeholder, nav);

          nav.style.position = 'fixed';
          nav.style.top = TOP + 'px';
          const left = rect.left + 'px';
          nav.style.left = left;
          nav.style.width = rect.width + 'px';
          nav.classList.add('shadow-2xl');
          fixed = true;
        }

        function toStatic() {
          if (!fixed) return;
          if (placeholder && placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
          nav.style.position = '';
          nav.style.top = '';
          nav.style.left = '';
          nav.style.width = '';
          nav.classList.remove('shadow-2xl');
          fixed = false;
        }

        function onScroll() {
          if (window.innerWidth < LG_MIN) {
            if (fixed) toStatic();
            return;
          }
          if (originalOffset === null) calcOriginalOffset();
          const scrolled = window.scrollY + TOP;
          if (scrolled >= originalOffset && !fixed) {
            toFixed();
          } else if (scrolled < originalOffset && fixed) {
            toStatic();
          }
        }

        function onResize() {
          if (fixed) toStatic();
          originalOffset = null;
          calcOriginalOffset();
          onScroll();
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        // initial check after next frame
        requestAnimationFrame(onScroll);
      })();
    </script>
  </>
)}
