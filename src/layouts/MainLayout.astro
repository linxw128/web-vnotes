---
import "@fontsource-variable/rubik";
import "../styles/base.css";

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  heroImage?: string;
}

const { title, description, heroImage } = Astro.props;
---

<!doctype html>
<html lang="ZH">
  <script>
    var _hmt = _hmt || [];
    (function () {
      var hm = document.createElement("script");
      hm.src = "https://hm.baidu.com/hm.js?166da62870e9cc4f43a33bf7cce0c72b";
      var s = document.getElementsByTagName("script")[0];
      s.parentNode.insertBefore(hm, s);
    })();
  </script>

  <BaseHead {title} {description} image={heroImage} />
  <ViewTransitions />

  <body class="bg-[#161616] text-stone-200">
    <Header />
    <main class="max-w-5xl px-3 md:px-6 mx-auto">
      <slot />
    </main>
    <Footer />

    <!-- Code copy buttons: inject copy button into each pre block -->
    <script>
      (function(){
        if (typeof window === 'undefined') return;
        function addCopyButtons(){
          const pres = document.querySelectorAll('pre');
          pres.forEach(pre => {
            if (pre.querySelector('.code-copy')) return; // already added
            const btn = document.createElement('button');
            btn.className = 'code-copy';
            btn.type = 'button';
            btn.setAttribute('aria-label', 'Copy code');
            btn.innerHTML = '<span class="label">复制</span><span class="copied" aria-hidden>已复制</span>';
            btn.addEventListener('click', async (e) => {
              const code = pre.querySelector('code');
              if (!code) return;
              const text = code.innerText || code.textContent || '';
              try {
                await navigator.clipboard.writeText(text);
                btn.classList.add('copied');
                setTimeout(()=> btn.classList.remove('copied'), 1400);
              } catch (err) {
                // fallback
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); btn.classList.add('copied'); setTimeout(()=> btn.classList.remove('copied'), 1400); } catch(e){}
                document.body.removeChild(ta);
              }
            });
            pre.appendChild(btn);
          });
        }
        document.addEventListener('DOMContentLoaded', addCopyButtons);
        // Also run after a short delay for content rendered after load
        setTimeout(addCopyButtons, 500);
      })();
    </script>

    <!-- Global delegated search handler (runs once on initial load) -->
    <script>
    (function(){
      if (typeof window === 'undefined') return;
      if (window.__astro_search_delegated) return;
      window.__astro_search_delegated = true;

      function escapeHtml(str) {
        return String(str).replace(/[&<>\"']/g, function(m){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'})[m]; });
      }

      function renderResultsInto(root, items) {
        const results = root.querySelector('#SearchResults');
        if (!items || items.length === 0) {
          results.innerHTML = '<div class="text-sm text-gray-400">No results</div>';
          return;
        }
        const html = items.map(item => {
          const title = item.title || '';
          return `<a href="/blog/${item.slug}"><div class="text-green-500 text-xl p-2 border-b border-zinc-800 hover:bg-zinc-800 hover:text-white transition-all ease-in-out duration-300 cursor-pointer">${escapeHtml(title)}</div></a>`;
        }).join('');
        results.innerHTML = html;
      }

      function ensurePosts(container) {
        if (container.__searchPosts) return container.__searchPosts;
        const dataEl = container.querySelector('.__SEARCH_INDEX_DATA');
        const raw = dataEl?.textContent || '[]';
        try {
          const posts = JSON.parse(raw);
          container.__searchPosts = posts;
          console.debug('[Search] index length:', posts.length);
          return posts;
        } catch (err) {
          console.error('[Search] failed to parse index JSON', err, raw.slice(0, 200));
          container.__searchPosts = [];
          return container.__searchPosts;
        }
      }

      document.addEventListener('input', function (e) {
        try {
          const el = e.target;
          if (!el || el.id !== 'SearchBox') return;
          const root = el.closest('.search-root');
          if (!root) return;
          const container = root.parentElement || root;
          const q = (el.value || '').trim().toLowerCase();
          if (!q) {
            renderResultsInto(root, []);
            return;
          }
          const posts = ensurePosts(container) || [];
          const filtered = posts.filter(p => {
            return (p.title && p.title.toLowerCase().includes(q)) || (p.description && p.description.toLowerCase().includes(q));
          }).slice(0, 20);
          console.debug('[Search] query:', q, 'results:', filtered.length);
          renderResultsInto(root, filtered);
        } catch (err) {
          console.error('[Search] unexpected error', err);
        }
      }, { capture: false });
    })();
    </script>

    <!-- Global TOC initializer: makes TOC sticky behavior work after client navigation -->
    <script>
    (function(){
      if (typeof window === 'undefined') return;
      if (window.__astro_toc_initialized) return;
      window.__astro_toc_initialized = true;

      const LG_MIN = 1024; // tailwind lg
      const TOP = 96; // px (top-24)

      function updateMaxHeight(ulEl) {
        const bottomMargin = 64;
        const available = Math.max(120, window.innerHeight - TOP - bottomMargin);
        ulEl.style.maxHeight = available + 'px';
      }

      function makeSticky(nav) {
        if (nav.__tocState && nav.__tocState.inited) return;
        const ulEl = nav.querySelector('#toc-list');
        let placeholder = null;
        let fixed = false;
        let originalOffset = null;

        function calcOriginalOffset() {
          if (placeholder && placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
          const rect = nav.getBoundingClientRect();
          originalOffset = rect.top + window.scrollY;
        }

        function toFixed() {
          if (fixed) return;
          const rect = nav.getBoundingClientRect();
          placeholder = document.createElement('div');
          placeholder.style.width = rect.width + 'px';
          placeholder.style.height = rect.height + 'px';
          nav.parentNode.insertBefore(placeholder, nav);

          nav.style.position = 'fixed';
          nav.style.top = TOP + 'px';
          nav.style.left = rect.left + 'px';
          nav.style.width = rect.width + 'px';
          nav.classList.add('shadow-2xl');
          fixed = true;
          updateMaxHeight(ulEl);
        }

        function toStatic() {
          if (!fixed) return;
          if (placeholder && placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
          nav.style.position = '';
          nav.style.top = '';
          nav.style.left = '';
          nav.style.width = '';
          nav.classList.remove('shadow-2xl');
          fixed = false;
        }

        function onScroll() {
          if (window.innerWidth < LG_MIN) {
            if (fixed) toStatic();
            return;
          }
          if (originalOffset === null) calcOriginalOffset();
          const scrolled = window.scrollY + TOP;
          if (scrolled >= originalOffset && !fixed) {
            toFixed();
          } else if (scrolled < originalOffset && fixed) {
            toStatic();
          }
          updateMaxHeight(ulEl);
        }

        function onResize() {
          if (fixed) toStatic();
          originalOffset = null;
          calcOriginalOffset();
          updateMaxHeight(ulEl);
          onScroll();
        }

        // attach handlers
        nav.__tocState = { inited: true, onScroll, onResize };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        requestAnimationFrame(onScroll);
      }

      function scanAndInit() {
        document.querySelectorAll('#toc-main').forEach(makeSticky);
      }

      // initialize now and on DOM mutations (client navigation)
      scanAndInit();
      const mo = new MutationObserver(scanAndInit);
      mo.observe(document.body, { childList: true, subtree: true });

      // Also re-run on navigation events if using SPA-like routing
      window.addEventListener('astro:navigation:end', scanAndInit);
    })();
    </script>
  </body>
</html>
