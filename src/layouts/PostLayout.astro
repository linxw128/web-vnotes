---
import type { CollectionEntry } from "astro:content";

import MainLayout from "./MainLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];
type Props_private_blog = CollectionEntry<"private_blog">["data"];
type Props_platform_blog = CollectionEntry<"platform_blog">["data"];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<MainLayout title={title} description={description}>
  <section class="w-full my-8">
    <div class="max-w-3xl mx-auto">
      {
        heroImage && (
          <div class="border border-zinc-800">
            <img
              src={heroImage}
              alt={title}
              class="w-full aspect-[2/1] object-cover"
            />
          </div>
        )
      }
      <div class="py-6 border-b border-zinc-800">
        <h1 class="text-center text-4xl font-semibold" transition:name={title}>
          {title}
        </h1>
        <div class="font-light text-sm text-center">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <>
                <span>&roarr;</span>
                <div class=" text-zinc-500 inline-block">
                  <FormattedDate date={updatedDate} />
                </div>
              </>
            )
          }
        </div>
      </div>
    </div>

    <!-- Main grid: centered container with sidebar + content -->
    <div class="w-full">
      <div class="max-w-5xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-[200px_minmax(0,1fr)] gap-8 items-start">
          <div class="hidden lg:block">
            <slot name="sidebar" />
          </div>
          <div>
            <article class="prose prose-invert py-8">
              <slot />
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
